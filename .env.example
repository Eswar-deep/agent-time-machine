# Official protocol checked 2026-10-30:
# https://dev.meta.ai/docs/cookbook/quickstart-chat-completions
# Create a key in your Meta dashboard; never put it in the browser or a commit.
MODEL_API_KEY=
# Choose a model that YOUR account can access. Current documented example:
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
# Live requests stay disabled until you explicitly set a bounded call allowance.
# This caps calls per run, including its attached proposal; it is not a dollar cap.
ATM_LIVE_MAX_CALLS=0
ATM_LIVE_MAX_OUTPUT_TOKENS=700
ATM_LIVE_TIMEOUT_SECONDS=30
# Optional. Omit for unknown monetary cost. USD per one million tokens.
META_INPUT_USD_PER_MILLION=
META_OUTPUT_USD_PER_MILLION=
# SQLite path defaults to data/agent-time-machine.sqlite3 in the repository.
# ATM_DATABASE=

